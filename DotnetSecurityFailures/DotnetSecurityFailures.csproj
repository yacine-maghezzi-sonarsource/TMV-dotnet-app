<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
	<PreserveCompilationContext>true</PreserveCompilationContext>
	<!-- Keep the intentionally downgraded vulnerable pins (e.g. System.Drawing.Common 4.7.0) restorable -->
	<NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\products.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\products.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Brism" Version="1.0.1" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.4.5" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="9.0.0" />
  </ItemGroup>

  <!--
    INTENTIONALLY VULNERABLE (OWASP A03:2025 Software Supply Chain Failures):
    dependencies pinned to versions with publicly known CVEs.
  -->
  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.9" />                               <!-- CVE-2018-1285 (XXE) -->
    <PackageReference Include="SharpZipLib" Version="1.3.2" />                           <!-- CVE-2021-32840, CVE-2021-32841, CVE-2021-32842 -->
    <PackageReference Include="DotNetZip" Version="1.16.0" />                            <!-- CVE-2024-48510 (path traversal, unmaintained) -->
    <PackageReference Include="YamlDotNet" Version="4.3.2" />                            <!-- CVE-2018-1000210 (unsafe deserialization) -->
    <PackageReference Include="Npgsql" Version="8.0.2" />                                <!-- CVE-2024-32655 (SQL injection via protocol overflow) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.2" />              <!-- CVE-2024-0056 (security feature bypass) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.32.0" />      <!-- CVE-2024-21319 (JWE DoS) -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.5.0" />             <!-- CVE-2021-26701 (RCE) -->
    <PackageReference Include="System.Drawing.Common" Version="4.7.0" />                 <!-- CVE-2021-24112 (RCE) -->
    <PackageReference Include="System.Net.Http" Version="4.3.0" />                       <!-- CVE-2018-8292 (information disclosure) -->
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />        <!-- CVE-2019-0820 (ReDoS) -->
    <!-- Declared but never called from the code: SCA reachability reports it as not reachable -->
    <PackageReference Include="MessagePack" Version="2.5.108" />                         <!-- CVE-2024-48924 (deserialization DoS) -->
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.Serialization.EnableUnsafeBinaryFormatterSerialization" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\backups\" />
    <Folder Include="wwwroot\js\" />
  </ItemGroup>

</Project>
